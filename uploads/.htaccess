# ================================================================
# امنیت پوشه uploads
# ================================================================

# 1. ممنوعیت دسترسی به پوشه اصلی uploads - فقط زیرپوشه tmp مجاز است
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^tmp/ - [L]
    RewriteRule .* - [F,L]
</IfModule>

# 2. عدم نمایش فهرست
Options -Indexes